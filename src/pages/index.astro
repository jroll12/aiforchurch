---
/* 01 Home. Section order and copy from design/home-c-desktop.dc.html and home-c-mobile.dc.html. */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import ModuleCard from '../components/ModuleCard.astro';
import StepCard from '../components/StepCard.astro';
import ChecklistItem from '../components/ChecklistItem.astro';
import SeatOption from '../components/SeatOption.astro';
import FaqItem from '../components/FaqItem.astro';
import { PH, ROUTES, SEAT_OPTIONS, SOLD_OUT } from '../config';
import { DESIGN } from '../copy';
import { url } from '../lib/url';
import FaqAnswer from '../components/FaqAnswer.astro';

// Sold out (HANDOFF-SPEC.md section 7): Reserve seats becomes "Join the waitlist" to /questions/.
const action = SOLD_OUT
  ? { label: DESIGN.waitlist, href: url(ROUTES.questions.path) }
  : { label: DESIGN.reserve, href: url(ROUTES.register.path) };
---
<Base page="home" headerCta markHref="#top">
<main id="top">
<section class="hero" aria-labelledby="h1"><div class="g">
<p class="eyebrow">A half-day workshop for church and ministry office staff</p>
<h1 id="h1">Turn a week of staff notes into a newsletter draft in your church’s voice.</h1>
<div class="l">
<p class="lede">{DESIGN.lede}</p>
<div class="cta"><Button href={action.href} arrow>{action.label}</Button><a class="ghost" href="#topics">See what we cover</a></div>
</div>
<div class="r">
<dl class="facts">
<div><dt>When</dt><dd>{PH.date}, {PH.startTime}</dd></div>
<div><dt>Where</dt><dd>{PH.venue}</dd></div>
<div><dt>Seats</dt><dd>{PH.seatsLeft} left</dd></div>
</dl>
<Notice variant="seatnote">{PH.seatsLeft} seats left for {PH.date} at {PH.venue}</Notice>
</div>
</div></section>

<section class="s" aria-labelledby="who"><div class="g">
<h2 class="lab" id="who">Who it is for</h2>
<div class="ct"><p class="big">{DESIGN.who}</p></div>
</div></section>

<section class="s" id="topics" aria-labelledby="do"><div class="g">
<h2 class="lab" id="do">What you will do</h2>
<div class="ct">
{DESIGN.topics.map((t) => <ModuleCard num={t.num} title={t.title}>{t.outcome}</ModuleCard>)}
<p class="more">{DESIGN.more}</p>
</div>
</div></section>

<section class="s" aria-labelledby="runs"><div class="g">
<h2 class="lab" id="runs">How the half-day runs</h2>
<div class="ct cols3">
<StepCard step={1} title="Learn the idea">A five-minute explanation of each task, in plain words.</StepCard>
<StepCard step={2} title="Try it">Work through a short exercise using invented sample files.</StepCard>
<StepCard step={3} title="Catch the mistake">Watch Claude get something wrong, then learn the habit that catches it.</StepCard>
</div>
</div></section>

<section class="s" aria-labelledby="leave"><div class="g">
<h2 class="lab" id="leave">What you leave with</h2>
<div class="ct"><ul class="sq" role="list">
<ChecklistItem>Handouts for each topic</ChecklistItem>
<ChecklistItem>Sample files to practice with, all invented</ChecklistItem>
<ChecklistItem>A draft AI use policy for your board to review [CONFIRM]</ChecklistItem>
</ul></div>
</div></section>

<section class="s" aria-labelledby="seats"><div class="g">
<h2 class="lab" id="seats">Choose your seats</h2>
<div class="ct">
<div class="tbl">
{SEAT_OPTIONS.map((o) => <SeatOption title={o.title} description={o.description} price={o.price} />)}
</div>
<Button href={action.href} arrow>{action.label}</Button>
</div>
</div></section>

<section class="s" aria-label="Safety and scope"><div class="g">
<h2 class="lab">Our promises</h2>
<div class="ct pair">
<Notice variant="box" label={DESIGN.safe.label}>{DESIGN.safe.text}</Notice>
<Notice variant="box" label={DESIGN.scope.label}>{DESIGN.scope.text}</Notice>
</div>
</div></section>

<section class="s faq" id="faq" aria-labelledby="q"><div class="g">
<h2 class="lab" id="q">Questions</h2>
<div class="ct">
{DESIGN.faq.map((f, k) => <FaqItem question={f.q} open={k === 0}><FaqAnswer item={f} /></FaqItem>)}
</div>
</div></section>
</main>
</Base>
