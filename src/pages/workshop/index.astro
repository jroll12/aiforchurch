---
/*
 * 02 Workshop details. Derived, not designed: no artboard exists. Content
 * from HANDOFF-SPEC.md section 7 (date, time, venue, accessibility; half-day
 * agenda; topics in order with a one-line outcome; what to bring; data safety),
 * built from the section pattern, ModuleCard, Notice and SeatOption.
 * Copy and its sources: src/copy.ts.
 */
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Notice from '../../components/Notice.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import ChecklistItem from '../../components/ChecklistItem.astro';
import SeatOption from '../../components/SeatOption.astro';
import AgendaRow from '../../components/AgendaRow.astro';
import { PH, ROUTES, SEAT_OPTIONS, SOLD_OUT } from '../../config';
import { BRING, DESIGN, WORKSHOP } from '../../copy';
import { url } from '../../lib/url';

const action = SOLD_OUT
  ? { label: DESIGN.waitlist, href: url(ROUTES.questions.path) }
  : { label: DESIGN.reserve, href: url(ROUTES.register.path) };
---
<Base page="workshop" title={WORKSHOP.title} markHref={url(ROUTES.home.path)}>
<main>
<section class="top plain" aria-labelledby="h1"><div class="g">
<h1 id="h1">{WORKSHOP.title}</h1>
<p class="lede">{DESIGN.lede}</p>
</div></section>

<section class="s" aria-labelledby="w1"><div class="g">
<h2 class="lab" id="w1">{WORKSHOP.whenLabel}</h2>
<div class="ct dl">
<dl class="facts">
<div><dt>When</dt><dd>{PH.date}, {PH.startTime}</dd></div>
<div><dt>Where</dt><dd>{PH.venue}</dd></div>
<div><dt>Seats</dt><dd>{PH.seatsLeft} left</dd></div>
<div><dt>{WORKSHOP.accessibilityLabel}</dt><dd>{WORKSHOP.accessibility}</dd></div>
</dl>
</div>
</div></section>

<section class="s" aria-labelledby="w2"><div class="g">
<h2 class="lab" id="w2">{WORKSHOP.agendaLabel}</h2>
<div class="ct dl">
<dl class="facts">{WORKSHOP.agenda.map((row) => <AgendaRow time={row.time} item={row.item} />)}</dl>
</div>
</div></section>

<section class="s" aria-labelledby="w3"><div class="g">
<h2 class="lab" id="w3">{WORKSHOP.topicsLabel}</h2>
<div class="ct">
{[...DESIGN.topics, ...WORKSHOP.laterTopics].map((t) => <ModuleCard num={t.num} title={t.title}>{t.outcome}</ModuleCard>)}
<p class="more">{DESIGN.more}</p>
</div>
</div></section>

<section class="s" aria-labelledby="w4"><div class="g">
<h2 class="lab" id="w4">{BRING.label}</h2>
<div class="ct"><ul class="sq" role="list">{BRING.items.map((item) => <ChecklistItem>{item}</ChecklistItem>)}</ul></div>
</div></section>

<section class="s" aria-labelledby="w5"><div class="g">
<h2 class="lab" id="w5">{WORKSHOP.safetyLabel}</h2>
<div class="ct"><Notice variant="box" label={DESIGN.safe.label}>{DESIGN.safe.text}</Notice></div>
</div></section>

<section class="s" aria-labelledby="w6"><div class="g">
<h2 class="lab" id="w6">{WORKSHOP.seatsLabel}</h2>
<div class="ct">
<div class="tbl">{SEAT_OPTIONS.map((o) => <SeatOption title={o.title} description={o.description} price={o.price} />)}</div>
<Button href={action.href} arrow>{action.label}</Button>
</div>
</div></section>
</main>
</Base>
