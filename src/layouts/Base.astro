---
/*
 * Base layout: every page shares this head, PageHeader and Footer.
 * tokens.css is imported once, unchanged, as the single token source.
 */
import '../../tokens.css';
import '../styles/site.css';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { NOINDEX, SITE_NAME } from '../config';

interface Props {
  page: 'home' | 'register' | 'workshop' | 'board' | 'about' | 'review' | 'confirmation' | 'questions';
  title?: string;
  headerCta?: boolean;
  markHref: string;
}

const { page, title, headerCta = false, markHref } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
{NOINDEX && <meta name="robots" content="noindex, nofollow">}
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
<div class={`pg pg-${page}`}>
<PageHeader cta={headerCta} markHref={markHref} />
<slot />
<Footer />
</div>
</body>
</html>
